# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...                     # anon / public key
SUPABASE_SERVICE_KEY=eyJ...             # service_role key (obligatoire côté backend pour la base)

# Schéma SQL : exécute une fois `supabase/migrations/001_schema.sql` dans le SQL Editor Supabase.

# ─── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

FILTER_MODEL=google/gemini-flash-1.5
# Erreur sur le filtre scope (LLM / JSON) : fail_open (défaut dev), fail_closed (tout rejeter),
# heuristic_then_closed (second seuil léger ; hors-scope si doute — recommandé en prod).
# FILTER_LLM_ERROR_POLICY=heuristic_then_closed
# Court-circuit : pas d'appel LLM filtre si heuristique locale très confiante (économie latence/coût)
# FILTER_HEURISTIC_SHORT_CIRCUIT=true
# Limite /api/chat/send par utilisateur (fenêtre glissante, mémoire du process — mettre un proxy en prod multi-workers).
# CHAT_SEND_RATE_LIMIT_ENABLED=true
# CHAT_SEND_RATE_LIMIT_MAX_REQUESTS=40
# CHAT_SEND_RATE_LIMIT_WINDOW_S=60
# SEARCH_ESTIMATE_RATE_LIMIT_ENABLED=true
# SEARCH_ESTIMATE_RATE_LIMIT_MAX_REQUESTS=80
# SEARCH_ESTIMATE_RATE_LIMIT_WINDOW_S=60
GUARD_MODEL=anthropic/claude-3.5-haiku
# Second passage Guard (liste longue ambiguïté sectorielle) si détecteur lexical — false = un seul appel LLM Guard
# GUARD_SECTOR_AMBIGUITY_SECOND_PASS=true
ORCHESTRATOR_MODEL=anthropic/claude-3.5-sonnet
# Journal JSON ``llm_usage`` sur stderr (tokens par étape LLM) — désactiver pour moins de bruit
# LLM_USAGE_LOG_ENABLED=true
# Atelier (création business) : plan stratégique + dossier. Si vide → ORCHESTRATOR_MODEL.
# ATELIER_BUSINESS_MODEL=anthropic/claude-3.5-sonnet
# Mode fake Atelier (dev UI) : réponses fixes, sans appels IA/API.
# ATELIER_FAKE_MODE=false

# ─── Google Places (recommandé) ──────────────────────────────────────────────
# Clé API avec l'API « Places (New) » activée — console.cloud.google.com/apis
# Permet de trouver des commerces/boutiques de niche introuvables via SIRENE seul.
GOOGLE_PLACES_API_KEY=

# ─── Pappers (optionnel) ─────────────────────────────────────────────────────
# Par défaut l’URL est api.pappers.in (international, en-tête api-key). Une clé invalide → 401, pas de fusion Pappers.
# Pour l’API France classique : PAPPERS_BASE_URL=https://api.pappers.fr/v2 (voir doc Pappers).
PAPPERS_API_KEY=
# Limite le nombre d'appels fiche entreprise pour téléphone/site (voir enrich_missing_contacts_pappers_fr)
# PAPPERS_CONTACT_ENRICH_MAX=60

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
# Production : URL(s) du frontend autorisées pour CORS (virgules). Si vide : localhost + SITE_URL.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# true uniquement pour tests CI sans Supabase (jamais en prod).
# SKIP_DB_VERIFY_ON_STARTUP=false
# Emails séparés par des virgules : export sans débit, solde API « illimité » (dev / comptes internes)
# UNLIMITED_CREDITS_EMAILS=toi@example.com
# Accès `/api/admin/*` et interface `/admin` (emails séparés par des virgules, insensible à la casse)
# ADMIN_EMAILS=toi@example.com
# Enregistrer runs/steps en base pour chaque requête chat (impact perf — désactivé par défaut)
# RUN_RECORDING_ENABLED=false
# true = traces [MONV.pipeline] sur stderr (même terminal que uvicorn)
# Lance uvicorn depuis le dossier ``backend/`` pour que le ``.env`` soit lu (config ``env_file``).
PIPELINE_DEBUG=false

# Perf — anneau d'échantillons durées pipeline (voir GET /api/admin/pipeline-timing)
# PIPELINE_TIMING_MAX_SAMPLES=500

# Cache process-local SIRENE / Google Places (TTL secondes, max entrées)
# CONNECTOR_CACHE_ENABLED=true
# CONNECTOR_CACHE_TTL_S=300
# CONNECTOR_CACHE_MAX_KEYS=256

# Jobs chat async (POST /api/chat/jobs) — stockage mémoire process
# CHAT_ASYNC_JOBS_MAX=200
# CHAT_ASYNC_JOB_RESULT_TTL_S=3600
